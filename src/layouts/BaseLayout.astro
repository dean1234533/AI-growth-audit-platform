---
import '../index.css';
import SeoHead from '../components/seo/SeoHead.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import CookieConsent from '../components/site/CookieConsent.astro';
import { AnnouncementBanner } from '../components/site/AnnouncementBanner';
import { InstallBanner } from '../components/pwa/InstallBanner';
import { THEME_INIT_SCRIPT } from '../lib/theme';
import { buildOrganizationSchema, buildSoftwareApplicationSchema } from '../lib/seo/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  noindex?: boolean;
  /** Hide the global header/footer chrome — used for the bare audit-tool experience. */
  bare?: boolean;
}

const { title, description, path, image, noindex, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <link rel="icon" type="image/png" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#3b82f6" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Growth Audit" />
    <SeoHead title={title} description={description} path={path} image={image} noindex={noindex} />
    <JsonLd schema={[buildOrganizationSchema(), buildSoftwareApplicationSchema()]} />
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "b89fe80abff1489294eea9f4b7cbef4f"}'></script>
  </head>
  <body class="bg-canvas text-ink dark:bg-[#0a0a12] dark:text-white">
    {!bare && <AnnouncementBanner client:idle />}
    {!bare && <SiteHeader />}
    <slot />
    {!bare && <SiteFooter />}
    {!bare && <CookieConsent />}
    <InstallBanner client:idle />
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
    <script is:inline>
      // Safari/WebKit has a long-standing bug where a `position: sticky` element fails to
      // recalculate its offset once a large amount of content is inserted below it by
      // JavaScript after the initial layout pass — exactly what happens on every page here,
      // since the main content is a client:only React island that renders nothing in the
      // server HTML and mounts its real content afterward. A passive CSS hint
      // (transform: translateZ(0), already applied in index.css) resolves this for small
      // layout shifts but is not reliably enough for a shift this large. This forces Safari to
      // fully redo the calculation: wait for the body's size to stop changing (i.e. the React
      // island has finished mounting its content), then briefly toggle the header out of
      // `sticky` and back, which makes WebKit recompute from scratch rather than reuse a stale
      // offset. One-shot — disconnects after the first settle, so it never fires again during
      // normal use (opening a modal, etc.) and can't cause a visible flicker later in the session.
      (function () {
        var headers = document.querySelectorAll('header.sticky');
        if (!headers.length || typeof ResizeObserver === 'undefined') return;
        var timer = null;
        var ro = new ResizeObserver(function () {
          clearTimeout(timer);
          timer = setTimeout(function () {
            ro.disconnect();
            headers.forEach(function (header) {
              header.style.position = 'static';
              void header.offsetHeight;
              header.style.position = '';
            });
          }, 250);
        });
        ro.observe(document.body);
      })();
    </script>
  </body>
</html>
