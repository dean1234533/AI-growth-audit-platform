---
export const prerender = true;
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Clock, User } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import ReadingProgressBar from '../../components/blog/ReadingProgressBar.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import ShareButtons from '../../components/blog/ShareButtons.astro';
import CtaBanner from '../../components/site/CtaBanner.astro';
import { buildArticleSchema } from '../../lib/seo/schema';
import { canonicalUrl } from '../../lib/seo/site';
import { getReadingTime, getRelatedPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, category, tags, author, publishDate, updatedDate } = post.data;
const readingTime = getReadingTime(post.body);
const allPosts = await getCollection('blog');
const related = getRelatedPosts(post, allPosts);

const schema = buildArticleSchema({
  title,
  description,
  path: `/blog/${post.id}`,
  publishDate,
  updatedDate,
  authorName: author,
});
---

<BaseLayout title={title} description={description} path={`/blog/${post.id}`}>
  <ReadingProgressBar />
  <JsonLd schema={schema} />
  <Breadcrumbs items={[{ name: 'Blog', path: '/blog' }, { name: title, path: `/blog/${post.id}` }]} />

  <article class="px-6 py-10 sm:py-16">
    <header class="mx-auto max-w-3xl text-center">
      <a href={`/blog/category/${category.toLowerCase().replace(/\s+/g, '-')}`} class="text-xs font-bold uppercase tracking-[0.2em] text-brand-500">
        {category}
      </a>
      <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl dark:text-white">{title}</h1>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-medium text-slate">
        <span class="inline-flex items-center gap-1.5">
          <User className="size-4" /> {author}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Clock className="size-4" /> {readingTime} min read
        </span>
        <time datetime={publishDate.toISOString()}>
          {publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      </div>
      <div class="mt-6 flex justify-center">
        <ShareButtons url={canonicalUrl(`/blog/${post.id}`)} title={title} />
      </div>
    </header>

    <div class="mx-auto mt-14 grid max-w-5xl gap-10 lg:grid-cols-[1fr_260px]">
      <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-display prose-a:text-brand-600 dark:prose-a:text-brand-400">
        <Content />
      </div>
      <aside class="hidden lg:block">
        <TableOfContents headings={headings} />
      </aside>
    </div>

    {
      tags.length > 0 && (
        <div class="mx-auto mt-10 flex max-w-3xl flex-wrap gap-2">
          {tags.map((tag) => (
            <a href={`/blog/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="glass rounded-full px-3 py-1 text-xs font-semibold text-slate transition-colors hover:text-brand-500">
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    {
      related.length > 0 && (
        <div class="mx-auto mt-16 max-w-3xl">
          <h2 class="font-display text-2xl font-bold text-ink dark:text-white">Related articles</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            {related.map((r) => (
              <a href={`/blog/${r.id}`} class="glass rounded-2xl p-5 transition-transform hover:-translate-y-1">
                <div class="text-xs font-bold uppercase tracking-wide text-brand-500">{r.data.category}</div>
                <div class="mt-2 text-sm font-semibold text-ink dark:text-white">{r.data.title}</div>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </article>

  <CtaBanner />
</BaseLayout>
