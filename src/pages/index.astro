---
import { getCollection } from 'astro:content';
import { ArrowRight } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditTool from '../components/AuditTool';
import Faq from '../components/landing/Faq.astro';
import { SITE_DESCRIPTION } from '../lib/seo/site';
import { sortByDateDesc } from '../lib/blog';

export const prerender = true;

const posts = sortByDateDesc(await getCollection('blog')).slice(0, 3);
const industries = (await getCollection('industries')).slice(0, 6);
---

<BaseLayout title="Free Website Audit UK — SEO & Website Health Check" description={SITE_DESCRIPTION} path="/">
  <main class="premium-public-shell">
  <AuditTool client:load />

  <section class="editorial-resource">
    <div class="editorial-resource-grid">
      <div>
        <span class="editorial-index">04 / Relevant by design</span>
        <h2>Specific advice beats generic scores.</h2>
        <p>Growth Audit adapts its checks to the kind of website it finds, so a local business and a web app are judged on the signals that actually matter to each.</p>
        <div class="editorial-industries">
          {industries.map((industry) => (
            <a href={`/industries/${industry.id}`}>
              {industry.data.name}
            </a>
          ))}
        </div>
      </div>

      {posts.length > 0 && (
        <div>
          <div class="editorial-guides-head">
            <div>
              <span>Practical guides</span>
              <h3>Improve with confidence</h3>
            </div>
            <a href="/blog">All guides →</a>
          </div>
          <div class="editorial-guides-list">
            {posts.map((post) => (
              <a href={`/blog/${post.id}`}>
                <span>{post.data.category}</span>
                <h3>{post.data.title}</h3>
                <ArrowRight className="size-4" />
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-14">
    <h2 class="font-display text-3xl font-bold tracking-tight text-ink dark:text-white">Choose the checks your website needs</h2>
    <p class="mt-4 max-w-3xl leading-7 text-slate">Start with search visibility, review overall website health or focus on local-business signals. Each audit explains what it can verify and what needs a separate check.</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">{[{href:'/seo-checker',label:'Free SEO checker'},{href:'/website-health-check',label:'Website health check'},{href:'/local-seo-audit',label:'Local SEO website audit'}].map(link=><li><a href={link.href} class="block rounded-xl border border-slate/20 p-5 font-semibold text-brand-600 underline underline-offset-4">{link.label}</a></li>)}</ul>
    <p class="mt-6 leading-7 text-slate"><a href="/guides/website-audit-checklist" class="text-brand-600 underline">Use the website audit checklist</a> or <a href="/guides/choosing-website-audit-tool" class="text-brand-600 underline">compare tools by the evidence you need</a>.</p>
  </section>
  <Faq />

  <section class="editorial-final-cta">
    <div>
      <div>
        <span>Ready when you are</span>
        <h2>See your website clearly.</h2>
        <p>Get the score, the evidence and the order to improve it in.</p>
      </div>
      <div>
        <a
          href="/#top"
        >
          Start Free Audit
        </a>
        <a
          href="/login?mode=signup"
        >
          Create Free Account
        </a>
      </div>
    </div>
  </section>
  </main>
</BaseLayout>
