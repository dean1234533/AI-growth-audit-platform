---
import { ChevronDown } from 'lucide-react';
import JsonLd from './JsonLd.astro';
import { buildFaqSchema } from '../../lib/seo/schema';

interface Props {
  items: { question: string; answer: string }[];
  title?: string;
}

const { items, title = 'Frequently Asked Questions' } = Astro.props;
const schema = buildFaqSchema(items);
---

<JsonLd schema={schema} />
<section class="mx-auto max-w-3xl px-6 py-16">
  <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink dark:text-white">{title}</h2>
  <div class="mt-8 space-y-3">
    {
      items.map((item) => (
        <details class="glass group rounded-2xl px-5 py-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink dark:text-white">
            {item.question}
            <ChevronDown className="size-4 shrink-0 text-slate transition-transform group-open:rotate-180" />
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
