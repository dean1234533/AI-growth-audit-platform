rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules. There is no
// Firebase CLI / automated deploy pipeline wired into this project (Cloudflare
// is the only deploy target so far), so this file is committed for reference
// and must be applied manually whenever it changes.
service cloud.firestore {
  match /databases/{database}/documents {

    // Mirrors the ADMIN_EMAIL constant and resolvePlanId()'s logic in src/server/lib/access.ts —
    // rules can't import that TS module, so this is a deliberate, minimal duplication of just the
    // "is this caller pro or admin" predicate (not the whole plan-resolution flow). Used only for
    // features that have no server API route to enforce through (competitors, scan frequency) —
    // anything with an API route (website creation, AI Coach, AI reports) enforces there instead,
    // where src/server/lib/access.ts is the single real source of truth.
    function isAdmin() {
      return request.auth.token.email == 'deanburt1308@gmail.com';
    }
    function isProOrAdmin() {
      return isAdmin()
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'pro';
    }

    // Anonymous, server-only collections — written exclusively via the service-account
    // REST client in src/server/lib/firestore.ts (functions/api routes), which
    // authenticates as an admin and bypasses these rules entirely. No client access.
    match /leads/{leadId} {
      allow read, write: if false;
    }
    match /newsletter/{subId} {
      allow read, write: if false;
    }
    match /contactMessages/{msgId} {
      allow read, write: if false;
    }
    // Daily Browser Rendering budget/priority counters (src/server/lib/scanBudget.ts) — written
    // exclusively by the service account from server code (the audit pipeline, cron). No client
    // needs to read or write this; a client that could would be able to see/forge scan-capacity
    // accounting. Already implicitly denied by there being no matching rule below, but stated
    // explicitly here (same pattern as leads/newsletter/contactMessages above) so it's obvious
    // this was a deliberate decision, not an oversight, the next time this file is read.
    match /scanBudget/{date} {
      allow read, write: if false;
    }

    // User profile/settings — owned solely by the signed-in user it belongs to. Billing fields
    // (plan, stripeCustomerId, stripeSubscriptionId) are excluded from client writes — those
    // are set exclusively by the Stripe webhook's service account (api/stripe/webhook.ts),
    // which bypasses these rules entirely, so a signed-in user can't just grant themselves
    // the Pro plan by editing the doc from devtools.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'stripeCustomerId', 'stripeSubscriptionId']);

      // Web Push subscriptions for this user's installed devices — the client writes its
      // own subscription right after the browser grants notification permission.
      match /pushSubscriptions/{subId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // In-app Notification Centre feed. Only ever created by the cron job's service
      // account (which bypasses these rules) or a trusted server route — the client may
      // only read its own notifications and mark them as read (update), never create or
      // delete them directly.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid;
        allow create, delete: if false;
      }

      // The user's own Gemini API key. Write-only from the client — the owner can set/replace/
      // remove it (a blind write; Firestore rules don't require a prior read for update/delete),
      // but NO ONE can ever read it back through the client SDK, not even the owner. The masked
      // "•••• last4" the Settings page shows comes from GET /api/gemini-key-status, a trusted
      // server route (src/pages/api/gemini-key-status.ts) that reads it via the service account
      // (which bypasses these rules) and returns only the last 4 characters, never the full key.
      match /secrets/gemini {
        allow read: if false;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Monitored websites — owned by the signed-in user who created them.
    match /websites/{websiteId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      // Creation is server-only (POST /api/websites, via the service account, which bypasses
      // these rules) — that route enforces the plan-based website limit (src/server/lib/access.ts)
      // before writing. Allowing a direct client create here would let a client add unlimited
      // websites by just calling the Firestore SDK instead of the quota-checked route.
      allow create: if false;
      // Only allow the owner to update their own doc, and only when uid is unchanged. Daily scan
      // frequency is a Pro feature — the settings UI writes frequency changes directly here (no
      // API route), so this is the only place that can actually enforce it. Grandfathered: if
      // frequency is already 'daily' (e.g. the user was Pro and downgraded), unrelated field
      // edits on the same doc still go through — this only blocks newly *setting* it to 'daily'.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.resource.data.uid == resource.data.uid
        && (
          request.resource.data.frequency == resource.data.frequency
          || request.resource.data.frequency != 'daily'
          || isProOrAdmin()
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;

      // Scan history for this website. Reads and creates are owner-only (the client
      // writes its own scan right after running an audit); updates/deletes are blocked
      // entirely — scan records are immutable once written, whether by the owner or by
      // the cron job's service account (which bypasses these rules).
      match /scans/{scanId} {
        allow read: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/websites/$(websiteId)).data.uid;
        allow create: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/websites/$(websiteId)).data.uid;
        allow update, delete: if false;
      }

      // Competitor websites tracked against this monitored website — same ownership model:
      // only the parent website's owner can read/add/update/remove a competitor, and only
      // the owner (or the cron service account, which bypasses rules) can write its scans.
      // Competitor monitoring is a Pro feature; the client writes directly here (no API route),
      // so this is the only enforcement point — adding one requires Pro/admin, but an existing
      // tracked competitor stays readable/removable if the owner later downgrades.
      match /competitors/{competitorId} {
        allow read, update, delete: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/websites/$(websiteId)).data.uid;
        allow create: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/websites/$(websiteId)).data.uid
          && isProOrAdmin();

        match /scans/{scanId} {
          allow read, create: if request.auth != null
            && request.auth.uid == get(/databases/$(database)/documents/websites/$(websiteId)).data.uid;
          allow update, delete: if false;
        }
      }
    }
  }
}
