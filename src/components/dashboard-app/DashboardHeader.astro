---
import NotificationBell from './NotificationBell';

interface Props {
  active?: 'dashboard' | 'audit' | 'monitoring' | 'coach' | 'reports' | 'settings';
}

const { active } = Astro.props;

const NAV = [
  { label: 'Dashboard', href: '/dashboard', key: 'dashboard' },
  { label: 'Audit', href: '/dashboard/audit', key: 'audit' },
  { label: 'Monitoring', href: '/dashboard/monitoring', key: 'monitoring' },
  { label: 'AI Coach', href: '/dashboard/coach', key: 'coach' },
  { label: 'Reports', href: '/dashboard/reports', key: 'reports' },
  { label: 'Settings', href: '/dashboard/settings', key: 'settings' },
];

const ACTIVE_CLASSES = ['bg-brand-500/10', 'text-brand-600', 'dark:text-brand-300'];
const INACTIVE_CLASSES = ['text-slate', 'hover:text-ink', 'dark:hover:text-white'];
---

<header class="sticky top-0 z-40 border-b border-ink/[0.06] bg-canvas/80 backdrop-blur-xl dark:border-white/10 dark:bg-[#0a0a12]/80">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-6 py-4">
    <a href="/dashboard" class="inline-flex shrink-0 items-center gap-2 font-display text-lg font-extrabold tracking-tight text-ink dark:text-white">
      <img src="/logo.jpg" alt="" width="32" height="32" class="size-8 rounded-xl" />
      Growth Audit
    </a>

    <nav class="hidden flex-1 items-center gap-1 overflow-x-auto text-sm font-semibold sm:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            data-nav-key={item.key}
            class={`whitespace-nowrap rounded-xl px-3 py-1.5 transition-colors ${
              active === item.key ? ACTIVE_CLASSES.join(' ') : INACTIVE_CLASSES.join(' ')
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1">
      <NotificationBell client:only="react" />
      <button
        type="button"
        id="mobile-nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        class="inline-flex items-center justify-center rounded-xl p-2 text-slate transition-colors hover:bg-ink/5 sm:hidden dark:hover:bg-white/5"
      >
        <svg id="mobile-nav-icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="6" y2="6" />
          <line x1="4" x2="20" y1="12" y2="12" />
          <line x1="4" x2="20" y1="18" y2="18" />
        </svg>
        <svg id="mobile-nav-icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <line x1="18" x2="6" y1="6" y2="18" />
          <line x1="6" x2="18" y1="6" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav-panel" class="hidden flex-col gap-1 border-t border-ink/[0.06] px-6 py-3 sm:hidden dark:border-white/10">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          data-nav-key={item.key}
          class={`block rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors ${
            active === item.key ? ACTIVE_CLASSES.join(' ') : INACTIVE_CLASSES.join(' ')
          }`}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script define:vars={{ ACTIVE_CLASSES, INACTIVE_CLASSES }}>
  // On the per-site detail page (`/dashboard/[id]#anchor`), the server can't see the URL
  // fragment to know which nav item to highlight — this corrects it client-side after the
  // hash is available, so the nav stays accurate when arriving via a SitePicker redirect.
  function syncActiveNavFromHash() {
    const hash = window.location.hash.replace('#', '');
    if (!hash) return;
    document.querySelectorAll('[data-nav-key]').forEach((el) => {
      const isActive = el.getAttribute('data-nav-key') === hash;
      el.classList.remove(...ACTIVE_CLASSES, ...INACTIVE_CLASSES);
      el.classList.add(...(isActive ? ACTIVE_CLASSES : INACTIVE_CLASSES));
    });
  }
  syncActiveNavFromHash();
  window.addEventListener('hashchange', syncActiveNavFromHash);

  const toggle = document.getElementById('mobile-nav-toggle');
  const panel = document.getElementById('mobile-nav-panel');
  const iconOpen = document.getElementById('mobile-nav-icon-open');
  const iconClose = document.getElementById('mobile-nav-icon-close');

  function setMenuOpen(open) {
    if (!toggle || !panel || !iconOpen || !iconClose) return;
    panel.classList.toggle('hidden', !open);
    panel.classList.toggle('flex', open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  toggle?.addEventListener('click', () => setMenuOpen(panel?.classList.contains('hidden')));
  panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
</script>
