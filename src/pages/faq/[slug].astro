---
export const prerender = true;
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import CtaBanner from '../../components/site/CtaBanner.astro';
import { buildFaqSchema } from '../../lib/seo/schema';

export async function getStaticPaths() {
  const entries = await getCollection('faq');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'faq'>;
}

const { entry } = Astro.props;
const { question, answer, category } = entry.data;
const schema = buildFaqSchema([{ question, answer }]);
---

<BaseLayout title={question} description={answer.slice(0, 155)} path={`/faq/${entry.id}`}>
  <JsonLd schema={schema} />
  <Breadcrumbs items={[{ name: 'FAQ', path: '/faq' }, { name: question, path: `/faq/${entry.id}` }]} />

  <section class="mx-auto max-w-3xl px-6 py-16">
    <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-500">{category}</span>
    <h1 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl dark:text-white">{question}</h1>
    <p class="glass mt-8 rounded-[24px] p-8 text-lg leading-relaxed text-slate">{answer}</p>
  </section>

  <CtaBanner />
</BaseLayout>
