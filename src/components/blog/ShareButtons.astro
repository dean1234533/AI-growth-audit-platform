---
import { X, Link2 } from 'lucide-react';

interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class="flex items-center gap-2">
  <span class="text-xs font-bold uppercase tracking-wide text-slate">Share</span>
  <a
    href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
    target="_blank"
    rel="noopener"
    aria-label="Share on X"
    class="glass flex size-9 items-center justify-center rounded-full text-ink transition-colors hover:bg-brand-500/10 dark:text-white"
  >
    <X className="size-4" />
  </a>
  <a
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
    target="_blank"
    rel="noopener"
    aria-label="Share on LinkedIn"
    class="glass flex size-9 items-center justify-center rounded-full text-ink transition-colors hover:bg-brand-500/10 dark:text-white"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" class="size-4">
      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56z" />
    </svg>
  </a>
  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    target="_blank"
    rel="noopener"
    aria-label="Share on Facebook"
    class="glass flex size-9 items-center justify-center rounded-full text-ink transition-colors hover:bg-brand-500/10 dark:text-white"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" class="size-4">
      <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z" />
    </svg>
  </a>
  <button
    type="button"
    id="copy-link-btn"
    data-url={url}
    aria-label="Copy link"
    class="glass flex size-9 items-center justify-center rounded-full text-ink transition-colors hover:bg-brand-500/10 dark:text-white"
  >
    <Link2 className="size-4" />
  </button>
</div>

<script>
  const btn = document.getElementById('copy-link-btn');
  btn?.addEventListener('click', async () => {
    const url = btn.getAttribute('data-url');
    if (!url) return;
    try {
      await navigator.clipboard.writeText(url);
      btn.classList.add('bg-mint-500/20');
      setTimeout(() => btn.classList.remove('bg-mint-500/20'), 1200);
    } catch {
      // Clipboard API unavailable — silently ignore, the other share buttons still work.
    }
  });
</script>
