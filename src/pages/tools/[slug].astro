---
export const prerender = true;
import { getCollection, type CollectionEntry } from 'astro:content';
import { CheckCircle2 } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import FaqAccordion from '../../components/seo/FaqAccordion.astro';
import CtaBanner from '../../components/site/CtaBanner.astro';
import AuditTool from '../../components/AuditTool';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const { name, seoTitle, metaDescription, intro, whatWeCheck, faq } = tool.data;
---

<BaseLayout title={seoTitle} description={metaDescription} path={`/tools/${tool.id}`}>
  <Breadcrumbs items={[{ name: 'Tools', path: '/tools' }, { name, path: `/tools/${tool.id}` }]} />

  <section class="px-6 pt-10 pb-16 sm:pt-16">
    <div class="mx-auto max-w-4xl text-center">
      <h1 class="font-display text-4xl font-extrabold tracking-tight text-ink sm:text-6xl dark:text-white">Free {name}</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate">{intro}</p>
    </div>

    <div class="mx-auto mt-12 max-w-xl">
      <AuditTool client:load compact />
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink dark:text-white">What Our {name} Checks</h2>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        whatWeCheck.map((item) => (
          <li class="glass flex items-start gap-3 rounded-2xl px-4 py-3.5 text-sm font-medium text-ink dark:text-slate-100">
            <CheckCircle2 className="mt-0.5 size-4 shrink-0 text-mint-500" />
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <FaqAccordion items={faq} />
  <CtaBanner />
</BaseLayout>
