---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DashboardHeader from '../../components/dashboard-app/DashboardHeader.astro';
import { FloatingBackground } from '../../components/landing/FloatingBackground';
import SitePicker from '../../components/dashboard-app/SitePicker';
---

<BaseLayout title="Audit" description="The full category breakdown and recommendations for your monitored website." path="/dashboard/audit" noindex bare>
  <DashboardHeader active="audit" />
  <div class="relative min-h-screen">
    <FloatingBackground />
    <SitePicker
      client:only="react"
      anchor="audit"
      eyebrow="Audit"
      title="Which website?"
      subtitle="Pick a monitored website to see what problems exist."
      emptyTitle="No website to audit yet"
      emptyBody="Add a website to monitor first — its full category breakdown will show up here."
    />
  </div>
</BaseLayout>
