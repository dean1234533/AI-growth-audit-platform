---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import DashboardHeader from '../../components/dashboard-app/DashboardHeader.astro';
import { FloatingBackground } from '../../components/landing/FloatingBackground';
import WebsiteDetail from '../../components/dashboard-app/WebsiteDetail';

const websiteId = Astro.params.websiteId!;
---

<BaseLayout title="Website Detail" description="Website health detail and scan history." path={`/dashboard/${websiteId}`} noindex bare>
  <DashboardHeader active="dashboard" />
  <div class="relative min-h-screen">
    <FloatingBackground />
    <WebsiteDetail client:only="react" websiteId={websiteId} />
  </div>
</BaseLayout>
