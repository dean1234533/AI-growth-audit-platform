---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DashboardHeader from '../../components/dashboard-app/DashboardHeader.astro';
import { FloatingBackground } from '../../components/landing/FloatingBackground';
import WebsiteHealthCentre from '../../components/dashboard-app/WebsiteHealthCentre';
---

<BaseLayout title="Dashboard" description="Your monitored websites and health scores." path="/dashboard" noindex bare>
  <DashboardHeader active="dashboard" />
  <div class="relative min-h-screen">
    <FloatingBackground />
    <WebsiteHealthCentre client:only="react" />
  </div>
</BaseLayout>
