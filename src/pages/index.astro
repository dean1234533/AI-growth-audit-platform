---
import { getCollection } from 'astro:content';
import { ArrowRight } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditTool from '../components/AuditTool';
import Faq from '../components/landing/Faq.astro';
import { SITE_DESCRIPTION } from '../lib/seo/site';
import { sortByDateDesc } from '../lib/blog';

export const prerender = true;

const posts = sortByDateDesc(await getCollection('blog')).slice(0, 3);
const industries = (await getCollection('industries')).slice(0, 6);
---

<BaseLayout title="Free AI Website Growth Audit & Report" description={SITE_DESCRIPTION} path="/">
  <main class="premium-public-shell">
  <AuditTool client:load />

  <section class="editorial-resource">
    <div class="editorial-resource-grid">
      <div>
        <span class="editorial-index">04 / Relevant by design</span>
        <h2>Specific advice beats generic scores.</h2>
        <p>Growth Audit adapts its checks to the kind of website it finds, so a local business and a web app are judged on the signals that actually matter to each.</p>
        <div class="editorial-industries">
          {industries.map((industry) => (
            <a href={`/industries/${industry.id}`}>
              {industry.data.name}
            </a>
          ))}
        </div>
      </div>

      {posts.length > 0 && (
        <div>
          <div class="editorial-guides-head">
            <div>
              <span>Practical guides</span>
              <h3>Improve with confidence</h3>
            </div>
            <a href="/blog">All guides →</a>
          </div>
          <div class="editorial-guides-list">
            {posts.map((post) => (
              <a href={`/blog/${post.id}`}>
                <span>{post.data.category}</span>
                <h3>{post.data.title}</h3>
                <ArrowRight className="size-4" />
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <Faq />

  <section class="editorial-final-cta">
    <div>
      <div>
        <span>Ready when you are</span>
        <h2>See your website clearly.</h2>
        <p>Get the score, the evidence and the order to improve it in.</p>
      </div>
      <div>
        <a
          href="/#top"
        >
          Start Free Audit
        </a>
        <a
          href="/login?mode=signup"
        >
          Create Free Account
        </a>
      </div>
    </div>
  </section>
  </main>
</BaseLayout>
