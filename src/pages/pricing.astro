---
import { CheckCircle2, CalendarCheck } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { CONSULTATION_URL } from '../lib/seo/site';
import { PLANS } from '../lib/plans';
---

<BaseLayout
  title="Pricing"
  description="Monitor your website's health for free, or upgrade to Pro for £5/month to track more sites with daily scans and competitor monitoring."
  path="/pricing"
>
  <Breadcrumbs items={[{ name: 'Pricing', path: '/pricing' }]} />

  <section class="px-6 pt-10 pb-20 sm:pt-16">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="font-display text-4xl font-extrabold tracking-tight text-ink sm:text-6xl dark:text-white">Simple, Honest Pricing</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate">
        Start monitoring your website for free. Upgrade to Pro when you want more sites, daily scans and competitor tracking.
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-3xl gap-6 sm:grid-cols-2">
      {
        PLANS.map((plan) => (
          <div class={`glass rounded-[28px] p-8 ${plan.id === 'pro' ? 'gradient-border gradient-border-brand' : ''}`}>
            <span
              class={`inline-flex rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide ${
                plan.id === 'pro' ? 'bg-brand-500/10 text-brand-600' : 'bg-mint-500/10 text-mint-600'
              }`}
            >
              {plan.name}
            </span>
            <div class="mt-4 font-display text-4xl font-extrabold text-ink dark:text-white">{plan.price}</div>
            <p class="mt-1 text-sm text-slate">{plan.id === 'free' ? 'Forever — no card, no trial period' : 'Cancel any time'}</p>
            <ul class="mt-6 space-y-3">
              {plan.features.map((item) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink dark:text-slate-100">
                  <CheckCircle2 className={`mt-0.5 size-4 shrink-0 ${plan.id === 'pro' ? 'text-brand-500' : 'text-mint-500'}`} />
                  {item}
                </li>
              ))}
            </ul>
            <a
              href="/login"
              class={
                plan.id === 'pro'
                  ? 'mt-8 block rounded-2xl bg-[linear-gradient(120deg,#6c63ff,#4b7cff)] px-5 py-3 text-center text-sm font-semibold text-white shadow-[0_16px_36px_-12px_rgba(108,99,255,0.55)]'
                  : 'glass mt-8 block rounded-2xl px-5 py-3 text-center text-sm font-semibold text-ink dark:text-white'
              }
            >
              {plan.id === 'free' ? 'Start Free' : 'Get Started'}
            </a>
          </div>
        ))
      }
    </div>

    <p class="mx-auto mt-10 max-w-xl text-center text-sm text-slate">
      No card required for the free plan. Upgrades and downgrades take effect immediately — no lock-in contract.
    </p>

    <div class="glass mx-auto mt-14 flex max-w-xl flex-col items-center gap-3 rounded-[28px] p-8 text-center">
      <p class="text-sm text-slate">Want your website's issues fixed by hand, not just flagged?</p>
      <a
        href={CONSULTATION_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:underline dark:text-brand-300"
      >
        <CalendarCheck className="size-4" /> Book a free consultation with Dean
      </a>
    </div>
  </section>
</BaseLayout>
