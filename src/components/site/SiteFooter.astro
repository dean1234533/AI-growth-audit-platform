---
const COLUMNS = [
  {
    title: 'Product',
    links: [
      { label: 'Start Free Audit', href: '/' },
      { label: 'Log In', href: '/login' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Blog', href: '/blog' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms', href: '/terms' },
    ],
  },
];
---

<footer class="editorial-footer">
  <div class="mx-auto max-w-7xl">
    <div class="editorial-footer-top">
      <div>
        <a href="/" class="inline-flex items-center gap-3 font-display text-xl font-extrabold tracking-tight text-white">
          <img src="/logo.jpg" alt="Growth Audit logo" width="38" height="38" class="size-[38px] rounded-lg" />
          Growth Audit
        </a>
        <p>
          Understand what your website needs. Improve what matters. Monitor what changes.
        </p>
      </div>

      {COLUMNS.map((col) => (
        <div>
          <div>{col.title}</div>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="editorial-footer-bottom">
      &copy; {new Date().getFullYear()} Growth Audit, built by <a href="https://dean-da-dev.co.uk" class="font-semibold text-brand-500">Dean Da Dev</a>.
    </div>
  </div>
</footer>
