---
import { ChevronRight, Home } from 'lucide-react';
import JsonLd from './JsonLd.astro';
import { buildBreadcrumbSchema, type BreadcrumbItem } from '../../lib/seo/schema';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const trail: BreadcrumbItem[] = [{ name: 'Home', path: '/' }, ...items];
const schema = buildBreadcrumbSchema(trail);
---

<JsonLd schema={schema} />
<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-6 pt-6 text-sm">
  <ol class="flex flex-wrap items-center gap-1.5 text-slate">
    {
      trail.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <ChevronRight className="size-3.5 shrink-0" />}
          {i === trail.length - 1 ? (
            <span class="font-medium text-ink dark:text-white">{item.name}</span>
          ) : (
            <a href={item.path} class="inline-flex items-center gap-1 transition-colors hover:text-brand-500">
              {i === 0 && <Home className="size-3.5" />}
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
