---
import { getCollection } from 'astro:content';
import { Search, Gauge, Accessibility, MapPin, ScanSearch, ArrowRight } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CtaBanner from '../../components/site/CtaBanner.astro';

const tools = await getCollection('tools');

const ICONS: Record<string, typeof Search> = {
  seo: Search,
  performance: Gauge,
  accessibility: Accessibility,
  localSeo: MapPin,
};
---

<BaseLayout
  title="Free Website Audit Tools"
  description="Every free AI-powered website tool in one place — SEO checker, speed test, accessibility checker, local SEO checker and more."
  path="/tools"
>
  <Breadcrumbs items={[{ name: 'Tools', path: '/tools' }]} />

  <section class="px-6 pt-10 pb-16 sm:pt-16">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="font-display text-4xl font-extrabold tracking-tight text-ink sm:text-6xl dark:text-white">Free Website Tools</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate">
        Every tool runs the same real, data-backed audit engine — pick the one that matches what you're checking, or run the full audit for the complete picture.
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-4xl gap-5 sm:grid-cols-2">
      {
        tools.map((tool) => {
          const Icon = ICONS[tool.data.category] ?? ScanSearch;
          return (
            <a href={`/tools/${tool.id}`} class="glass gradient-border gradient-border-brand group flex items-start gap-4 rounded-[24px] p-6 transition-transform hover:-translate-y-1">
              <div class="inline-flex size-11 shrink-0 items-center justify-center rounded-2xl bg-[linear-gradient(135deg,#6c63ff,#4b7cff)] text-white">
                <Icon className="size-5" />
              </div>
              <div>
                <div class="font-display font-bold text-ink dark:text-white">{tool.data.name}</div>
                <p class="mt-1.5 text-sm leading-relaxed text-slate">{tool.data.intro.slice(0, 110)}…</p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-500">
                  Try it free <ArrowRight className="size-3.5" />
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
