---
import { PLANS } from '../../lib/plans';
import JsonLd from '../seo/JsonLd.astro';
import { buildFaqSchema } from '../../lib/seo/schema';

const FREE = PLANS.find((p) => p.id === 'free')!;
const PRO = PLANS.find((p) => p.id === 'pro')!;

// Every answer here must match what the product actually does — pulled
// from the same PLANS source as the pricing section, not written by hand.
const FAQS = [
  {
    q: 'What is Growth Audit?',
    a: 'Growth Audit checks your website for SEO, performance, accessibility, local SEO and conversion issues, then tells you what needs fixing. You can run a free audit instantly, or create an account to save your website and monitor it automatically over time.',
  },
  {
    q: 'Is the audit really free?',
    a: 'Yes. Running an audit is completely free and does not require an account. Monitoring more than one website ongoing is the part that requires the paid plan.',
  },
  {
    q: 'Do I need an account to run an audit?',
    a: 'No. You can run a full audit on any website without creating an account.',
  },
  {
    q: 'What do I get with a free account?',
    a: `${FREE.websiteLimit} monitored website, with ${FREE.features.filter((f) => f !== `${FREE.websiteLimit} monitored website`).join(', ').toLowerCase()}, plus your audit history saved in one place.`,
  },
  {
    q: 'How many websites can I monitor?',
    a: `On the Free plan, ${FREE.websiteLimit} website.`,
  },
  {
    q: 'How many websites can I monitor on Pro?',
    a: `Up to ${PRO.websiteLimit} websites, with ${PRO.features.filter((f) => !f.includes('monitored website')).join(', ').toLowerCase()}.`,
  },
  {
    q: 'What happens when I upgrade?',
    a: `You can monitor up to ${PRO.websiteLimit} websites instead of ${FREE.websiteLimit}, with daily scans, competitor monitoring and weekly AI reports.`,
  },
  {
    q: 'Can I cancel?',
    a: 'Yes — you can cancel any time from your billing settings. There is no lock-in contract.',
  },
];
---

<JsonLd schema={buildFaqSchema(FAQS.map((item) => ({ question: item.q, answer: item.a })))} />

<section id="faq" class="editorial-faq">
  <div class="editorial-faq-grid">
    <header>
      <span class="editorial-index">05 / Questions</span>
      <h2>Everything worth knowing before you start.</h2>
      <p>The audit is free, anonymous and does not commit you to anything.</p>
      <a href="/contact">Still have a question? Contact us →</a>
    </header>

    <div class="editorial-faq-list">
      {
        FAQS.map((item) => (
          <details class="group [&_summary::-webkit-details-marker]:hidden">
            <summary>
              {item.q}
              <span>+</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
