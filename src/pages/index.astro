---
import { getCollection } from 'astro:content';
import { ArrowRight } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditTool from '../components/AuditTool';
import CtaBanner from '../components/site/CtaBanner.astro';
import { SITE_DESCRIPTION } from '../lib/seo/site';
import { sortByDateDesc } from '../lib/blog';

const posts = sortByDateDesc(await getCollection('blog')).slice(0, 3);
const industries = (await getCollection('industries')).slice(0, 6);
---

<BaseLayout title="Free AI Website Growth Audit" description={SITE_DESCRIPTION} path="/">
  <AuditTool client:load />

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="mb-10 text-center">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-500">By industry</span>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl dark:text-white">
        Built for your kind of business
      </h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        industries.map((industry) => (
          <a href={`/industries/${industry.id}`} class="glass group flex items-center justify-between gap-3 rounded-2xl px-6 py-5 transition-transform hover:-translate-y-1">
            <span class="font-semibold text-ink dark:text-white">{industry.data.name}</span>
            <ArrowRight className="size-4 text-brand-500 transition-transform group-hover:translate-x-1" />
          </a>
        ))
      }
    </div>
    <div class="mt-6 text-center">
      <a href="/industries" class="text-sm font-semibold text-brand-500 hover:underline">See all industries →</a>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 py-16">
        <div class="mb-10 text-center">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-500">From the blog</span>
          <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl dark:text-white">
            Latest advice
          </h2>
        </div>
        <div class="grid gap-5 sm:grid-cols-3">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="glass flex h-full flex-col rounded-[24px] p-6 transition-transform hover:-translate-y-1">
              <span class="text-xs font-bold uppercase tracking-wide text-brand-500">{post.data.category}</span>
              <h3 class="mt-2 font-display font-bold text-ink dark:text-white">{post.data.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <CtaBanner
    heading="Prefer to Talk It Through?"
    body="Book a free, no-obligation consultation and we'll walk through your results together."
  />
</BaseLayout>
