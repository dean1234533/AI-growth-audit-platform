<aside
  id="cookie-consent"
  aria-label="Cookie consent"
  class="glass fixed inset-x-4 bottom-4 z-[60] mx-auto max-w-xl rounded-2xl p-5 shadow-2xl sm:inset-x-auto sm:right-6 sm:bottom-6"
>
  <p class="font-semibold text-ink dark:text-white">Your privacy choices</p>
  <p class="mt-2 text-sm leading-relaxed text-slate">
    Growth Audit uses essential browser storage for sign-in, preferences and app features. You can
    allow optional cookies if they are introduced later, or continue with essential storage only.
    <a href="/privacy" class="font-semibold text-brand-700 underline dark:text-brand-200">Read our privacy policy</a>.
  </p>
  <div class="mt-4 flex flex-wrap gap-3">
    <button
      type="button"
      data-cookie-choice="all"
      class="rounded-xl bg-brand-700 px-4 py-3 text-sm font-semibold text-white"
    >
      Accept all
    </button>
    <button
      type="button"
      data-cookie-choice="essential"
      class="rounded-xl border border-ink/15 px-4 py-3 text-sm font-semibold text-ink dark:border-white/20 dark:text-white"
    >
      Essential only
    </button>
  </div>
</aside>

<script>
  const banner = document.querySelector<HTMLElement>('#cookie-consent');
  const storedChoice = localStorage.getItem('ga_cookie_consent');
  if (storedChoice) banner?.remove();

  banner?.querySelectorAll<HTMLButtonElement>('[data-cookie-choice]').forEach((button) => {
    button.addEventListener('click', () => {
      localStorage.setItem('ga_cookie_consent', button.dataset.cookieChoice ?? 'essential');
      banner.remove();
    });
  });
</script>
