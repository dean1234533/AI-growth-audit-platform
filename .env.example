# Firebase client SDK config — copy to .env.local and fill in from
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and config.
# Used by src/lib/firebaseClient.ts for Firebase Auth + client-side Firestore access in the
# authenticated dashboard. Must enable Email/Password + Google sign-in providers in
# Firebase Console -> Authentication -> Sign-in method, and paste firestore.rules into
# Firebase Console -> Firestore Database -> Rules.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
