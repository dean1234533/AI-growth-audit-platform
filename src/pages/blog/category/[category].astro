---
export const prerender = true;
import { getCollection } from 'astro:content';
import { Clock } from 'lucide-react';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import CtaBanner from '../../../components/site/CtaBanner.astro';
import { getReadingTime, sortByDateDesc } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { category: category.toLowerCase().replace(/\s+/g, '-') },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  }));
}

interface Props {
  category: string;
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
}

const { category, posts } = Astro.props;
const slug = category.toLowerCase().replace(/\s+/g, '-');
const sorted = sortByDateDesc(posts);
---

<BaseLayout
  title={`${category} Articles`}
  description={`All blog articles about ${category.toLowerCase()} — practical, plain-English advice.`}
  path={`/blog/category/${slug}`}
>
  <Breadcrumbs items={[{ name: 'Blog', path: '/blog' }, { name: category, path: `/blog/category/${slug}` }]} />

  <section class="px-6 pt-10 pb-16 sm:pt-16">
    <div class="mx-auto max-w-3xl text-center">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-500">Category</span>
      <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-ink sm:text-6xl dark:text-white">{category}</h1>
    </div>

    <div class="mx-auto mt-14 grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        sorted.map((post) => (
          <a href={`/blog/${post.id}`} class="glass flex h-full flex-col rounded-[24px] p-6 transition-transform hover:-translate-y-1">
            <h3 class="font-display font-bold text-ink dark:text-white">{post.data.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate">{post.data.description}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-slate">
              <Clock className="size-3.5" /> {getReadingTime(post.body)} min read
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
